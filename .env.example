NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/feelvie
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=120d
CORS_ORIGIN=http://localhost:3000
# Proxy hops in front of the server. Set to 1 behind a dev tunnel or load balancer.
TRUST_PROXY=0
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MOCK=true
ADMIN_JWT_EXPIRES_IN=1d
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JOBS_ENABLED=true
VTON_API_URL=https://vton.feelvie.com/api/v1/tryon/generate
VTON_API_KEY=
VTON_TIMEOUT_MS=120000
PUBLIC_BASE_URL=http://localhost:5000
UPLOADS_DIR=uploads
